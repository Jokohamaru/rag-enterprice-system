# === AI Model API (LLM trả lời câu hỏi - tách độc lập với Embedding) ===
# Chọn nhà cung cấp LLM: gemini | openai_compatible | none
LLM_PROVIDER=gemini
# Nếu dùng gemini: có thể dùng chung GEMINI_API_KEY bên dưới hoặc đặt riêng LLM_API_KEY
LLM_API_KEY=
# Dùng cho openai_compatible (OpenAI, OpenRouter, Groq, DeepSeek, Ollama local...)
LLM_BASE_URL=https://api.openai.com/v1
# Để trống để tự dùng GEMINI_GENERATION_MODEL (khi gemini) hoặc gpt-4o-mini (khi openai_compatible)
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=45.0

# --- Ví dụ chuyển sang OpenRouter / Groq / Ollama local ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini
#
# Ollama local (không cần API key):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b

# === Embedding & Google Gemini ===
GEMINI_API_KEY=
# Chọn provider embedding: gemini | openai_compatible | mock
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_CONTEXT_MODEL=gemini-2.5-flash-lite
GEMINI_GENERATION_MODEL=gemini-2.5-flash

# === Retrieval & Reranking ===
RETRIEVAL_DEFAULT_TOP_K=6
RETRIEVAL_CANDIDATE_K=20
# none | lexical | llm
RERANKER_PROVIDER=lexical
QUERY_REWRITE_ENABLED=true
CONTEXT_MAX_TOKENS=6000

# === MongoDB Vector Database ===
# Mặc định khớp với container Docker trong backend/docker-compose.yml (cổng 27017); đổi cổng 27018 nếu dùng backend/docker-compose.atlas.yml
MONGODB_URI=mongodb://admin:password123@localhost:27017/?authSource=admin
MONGODB_DB_NAME=rag_enterprise
# auto | atlas | community
MONGODB_VECTOR_MODE=auto

# === Knowledge Base & Storage ===
STORAGE_DIR=storage
DEFAULT_TENANT_ID=default-org
MAX_FILE_SIZE_MB=50

# === Chunking & Contextual Retrieval ===
# recursive | parent_child | semantic
CHUNKING_STRATEGY=recursive
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=80
PARENT_CHUNK_SIZE_TOKENS=1000
PARENT_CHUNK_OVERLAP_TOKENS=100
CHILD_CHUNK_SIZE_TOKENS=250
CHILD_CHUNK_OVERLAP_TOKENS=50
SEMANTIC_BREAKPOINT_PERCENTILE=20.0
# header | llm
CONTEXTUAL_MODE=header

# === API ===
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
